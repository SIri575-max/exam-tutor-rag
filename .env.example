# Optional external model service. Offline retrieval works without this file.
# Copy to .env and configure locally. Never paste API keys into the chat or Git.
# Enable only when you want retrieved snippets and your question sent to your provider.
TUTOR_ENABLE_LLM=0
# Use the exact HTTPS compatible-mode/v1 endpoint from your provider workspace.
TUTOR_BASE_URL=
TUTOR_MODEL=
TUTOR_API_KEY=
# Set 0 only when the model endpoint should connect directly instead of using OS/env proxies.
TUTOR_TRUST_ENV_PROXY=1
